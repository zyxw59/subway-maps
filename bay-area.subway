line_width = 2;
inner_radius = 20;

title "Rail Frequencies in the Bay Area";
style "railfreq.css";

unit = 40;

N  = unit * dir 0;
NE = unit * dir 45;
E  = unit * dir 90;
SE = unit * dir 135;
S  = unit * dir 180;
SW = unit * dir 225;
W  = unit * dir 270;
NW = unit * dir 315;

origin = (0, 0);

n0 = origin >> W;
n1 = n0 ^^ unit;
n2 = n0 ^^ (2 * unit);
n3 = n0 ^^ (3 * unit);
n4 = n0 ^^ (4 * unit);
n5 = n0 ^^ (5 * unit);
n7 = n0 ^^ (7 * unit);
n8 = n0 ^^ (8 * unit);
n16 = n0 ^^ (16 * unit);

s1 = n0 ^^ (-1 * unit);
s2 = n0 ^^ (-2 * unit);
s3 = n0 ^^ (-3 * unit);
s4 = n0 ^^ (-4 * unit);
s5 = n0 ^^ (-5 * unit);
s6 = n0 ^^ (-6 * unit);
s7 = n0 ^^ (-7 * unit);
s8 = n0 ^^ (-8 * unit);
s9 = n0 ^^ (-9 * unit);
s10 = n0 ^^ (-10 * unit);
s11 = n0 ^^ (-11 * unit);
s12 = n0 ^^ (-12 * unit);
s13 = n0 ^^ (-13 * unit);
s14 = n0 ^^ (-14 * unit);
s15 = n0 ^^ (-15 * unit);
s16 = n0 ^^ (-16 * unit);
s17 = n0 ^^ (-17 * unit);
s18 = n0 ^^ (-18 * unit);
s19 = n0 ^^ (-19 * unit);
s20 = n0 ^^ (-20 * unit);
s21 = n0 ^^ (-21 * unit);
s22 = n0 ^^ (-22 * unit);
s23 = n0 ^^ (-23 * unit);
s24 = n0 ^^ (-24 * unit);
s25 = n0 ^^ (-25 * unit);
s26 = n0 ^^ (-26 * unit);
s27 = n0 ^^ (-27 * unit);
s28 = n0 ^^ (-28 * unit);
s29 = n0 ^^ (-29 * unit);
s30 = n0 ^^ (-30 * unit);
s31 = n0 ^^ (-31 * unit);
s32 = n0 ^^ (-32 * unit);
s33 = n0 ^^ (-33 * unit);
s34 = n0 ^^ (-34 * unit);
s35 = n0 ^^ (-35 * unit);
s37 = n0 ^^ (-37 * unit);
s38 = n0 ^^ (-38 * unit);
s39 = n0 ^^ (-39 * unit);
s40 = n0 ^^ (-40 * unit);
s41 = n0 ^^ (-41 * unit);
s42 = n0 ^^ (-42 * unit);
s43 = n0 ^^ (-43 * unit);

e0 = origin >> N;
e1 = e0 ^^ (1 * unit);
e2 = e0 ^^ (2 * unit);
e3 = e0 ^^ (3 * unit);
e4 = e0 ^^ (4 * unit);
e5 = e0 ^^ (5 * unit);
e6 = e0 ^^ (6 * unit);
e7 = e0 ^^ (7 * unit);
e8 = e0 ^^ (8 * unit);
e9 = e0 ^^ (9 * unit);
e10 = e0 ^^ (10 * unit);
e11 = e0 ^^ (11 * unit);
e12 = e0 ^^ (12 * unit);
e13 = e0 ^^ (13 * unit);
e14 = e0 ^^ (14 * unit);
e15 = e0 ^^ (15 * unit);
e16 = e0 ^^ (16 * unit);
e17 = e0 ^^ (17 * unit);
e19 = e0 ^^ (19 * unit);
e20 = e0 ^^ (20 * unit);
e22 = e0 ^^ (22 * unit);
e23 = e0 ^^ (23 * unit);
e25 = e0 ^^ (25 * unit);
e28 = e0 ^^ (28 * unit);

w6 = e0 ^^ (-6 * unit);
w8 = e0 ^^ (-8 * unit);
w11 = e0 ^^ (-11 * unit);
w14 = e0 ^^ (-14 * unit);

wye = n0 & e4;

st12 = e4 & n1;
st19 = e4 & n2;
mcar = e4 & n3;
_k30  = e4 & n4;

cline0 = _k30 >> NE;
rock = cline0 & e5;
orin = cline0 & e7;
_c25 = cline0 & n8;
lafy = n8 & e10;
_c35 = n8 & e12;
cline1 = _c35 >> NE;
wcrk = cline1 & e13;
phil = cline1 & e15;
conc = cline1 & e17;
ncon = cline1 & e19;
_c75 = cline1 & n16;
pitt = n16 & e22;
pctr = n16 & e25;
antc = n16 & e28;

ashb = e4 & n5;
dbrk = e4 & n7;
_r25 = e4 & n8;
rline0 = _r25 >> NW;
nbrk = rline0 & e3;
plza = rline0 & e2;
deln = rline0 & e1;
rich = rline0 & e0;

lake = e4 & s1;
_a15 = e4 & s2;
aline0 = _a15 >> SE;
ftvl = aline0 & s5;
cols = aline0 & s7;
sanl = aline0 & s9;
bayf = aline0 & s11;
_l00 = aline0 & s12;
hayw = aline0 & s14;
shay = aline0 & s16;
ucty = aline0 & s18;
fmnt = aline0 & s20;
_s15 = aline0 & e25;
warm = e25 & s25;
milp = e25 & s31;
bery = e25 & s34;

cast = s12 & e17;
wdub = s12 & e20;
dubl = s12 & e23;

woak = n0 & e2;
_m15 = n0 & w6;
mline0 = _m15 >> SW;
embr = mline0 & s1;
mont = mline0 & s2;
powl = mline0 & s3;
civc = mline0 & s4;
_m45 = mline0 & w11;
st16 = w11 & s6;
st24 = w11 & s8;
_m65 = w11 & s9;
mline1 = _m65 >> SW;
glen = mline1 & s10;
balb = mline1 & s11;
_m85 = mline1 & w14;
daly = w14 & s13;
_w05 = w14 & s14;
wline0 = _w05 >> SE;
colm = wline0 & s15;
ssan = wline0 & s16;
sbrn = wline0 & s17;
_w35 = wline0 & s18;
_y05 = s18 & w6;
sfia = w6 & s19;
_y15 = w6 & s20;

king = w6 & s4;
caltrain0 = king >> SW;
caltrain1 = w8;
_ct1 = caltrain0 & caltrain1;
st22 = caltrain1 & s8;
bays = caltrain1 & s13;
ssfc = caltrain1 & s15;
sbrc = caltrain1 & s17;
caltrain2 = wline0;
_ct2 = caltrain1 & caltrain2;
mlbr = caltrain2 & s21;
bdwy = caltrain2 & s22;
burl = caltrain2 & s23;
smat = caltrain2 & s24;
hayp = caltrain2 & s25;
hils = caltrain2 & s26;
belm = caltrain2 & s27;
scar = caltrain2 & s28;
rwct = caltrain2 & s29;
menp = caltrain2 & s30;
palo = caltrain2 & s31;
cali = caltrain2 & s32;
sant = caltrain2 & s33;
caltrain3 = s34;
_ct3 = caltrain2 & caltrain3;
mtnv = caltrain3 & e8;
sndl = caltrain3 & e11;
lawr = caltrain3 & e14;
_ct4 = caltrain3 & e16;
caltrain4 = _ct4 >> SE;
scla = caltrain4 & s35;
sjdi = caltrain4 & s37;
tami = caltrain4 & s38;
capi = caltrain4 & s39;
blos = caltrain4 & s40;
morg = caltrain4 & s41;
smar = caltrain4 & s42;
gilr = caltrain4 & s43;

top =   -24 * unit;
bottom = 48 * unit;
left =  -16 * unit;
right =  36 * unit;

route.tph2 caltrain_local: king -- _ct1 -- _ct2 -- _ct3 -- _ct4 -- sjdi;

route.tph3 bart_antioch: antc -- pitt;
route.tph6 bart_pittsburg: pitt -- _c75 -- _c35 -- _c25 -- _k30 --(-3) mcar;
route.tph12 bart_k: mcar -- st12;

route.tph6 bart_richmond: rich -- _r25 --(3) mcar;

route.tph3 bart_ka: st12 --(4.5) lake;
route.tph9 bart_km: st12 --(-1.5) wye --(3) woak;
route.tph6 bart_am: lake -- wye --(-4.5) woak;

route.tph9 bart_a: lake --(1.5) _a15 -- bayf;
route.tph3 bart_dublin: bayf --(-3) _l00 -- dubl;
route.tph6 bart_beryessa: bayf --(1.5) _s15 -- bery;

route.tph15 bart_daly: woak -- _m15 -- _m45 -- _m65 -- _m85 -- daly;
route.tph9 bart_sfia: daly --(3) _w05 -- _w35 -- _y05 -- sfia;
route.tph3 bart_milbrae: sfia --(3) _y15 -- mlbr;
